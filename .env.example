# AWS Bedrock (us-east-1). 실제 값은 .env에만 넣고 커밋하지 않습니다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1

# 대상 사이트 데모 계정 (config/settings.yaml의 demo_account_env 이름과 일치)
DEMO_USERNAME=
DEMO_PASSWORD=

# 선택: LangSmith 트레이스 (키가 있을 때만 켜짐)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
