# Legacy2Next 비밀값. 이 파일을 .env로 복사해 값을 채운다. .env는 커밋하지 않는다

# AWS Bedrock
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Bedrock Claude 모델 ID (Mantle 클라이언트, anthropic. 접두사)
BEDROCK_MODEL_ID=anthropic.claude-sonnet-5-5
# 거절(refusal) 시 다시 시도할 대체 모델. 비우면 대체하지 않는다
BEDROCK_FALLBACK_MODEL_ID=anthropic.claude-sonnet-5
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# 대상 사이트 로그인 계정 (로그인이 필요한 사이트만)
# 이름 규칙: SITE_<별칭 대문자, 하이픈은 밑줄>_USERNAME / _PASSWORD
# 예: 별칭 hr-portal
# SITE_HR_PORTAL_USERNAME=
# SITE_HR_PORTAL_PASSWORD=
